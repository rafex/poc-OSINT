# ── Secrets y configuración sensible ─────────────────────────────────────────
.env
.env.*
!.env.example
*.secret
credentials/

# secrets/ — solo ignorar versiones descifradas y temporales.
# secrets/secrets.enc.yaml (cifrado con SOPS+age) SÍ se commitea.
secrets/*.dec.yaml
secrets/*.dec.json
secrets/*.plaintext.*
secrets/*.tmp
secrets/age-*.key

# La clave privada age vive en ~/.age/ (fuera del repo), nunca aquí.
*.age-key
age-secret-key*
config/local.py
config/local.yaml
config/local.json
api_keys.txt
tokens.txt

# ── Datos OSINT — nunca subir resultados ni targets ───────────────────────────
