# ── Imágenes y archivos exportados de contenedor ─────────────────────────────
# Archivos generados por `podman save` / `docker save`
*.tar
*.tar.gz
*.oci

# Contextos de build temporales
.containerignore.tmp

# Capas y cache de buildah/podman build
.build/
overlay/

# Credenciales de registros (nunca deben estar aquí)
auth.json
registry-credentials.json
*.creds

# Archivos de compose con datos de entorno local
compose.override.yaml
compose.override.yml
docker-compose.override.yaml
docker-compose.override.yml

# Volúmenes montados localmente durante pruebas
mnt/
volumes/
