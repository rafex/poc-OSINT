# ── Stage 1: source ────────────────────────────────────────────────────────────
FROM alpine:3 AS source

RUN apk add --no-cache git ca-certificates
RUN git clone --depth 1 https://github.com/mxrch/GitFive /src/gitfive

# ── Stage 2: builder ───────────────────────────────────────────────────────────
# Pillow y levenshtein tienen extensiones C con wheels musllinux en PyPI.
# Los headers de imagen son necesarios solo si Pillow no encuentra wheel musl.
FROM python:3.11-alpine AS builder

RUN apk add --no-cache gcc musl-dev g++ \
        jpeg-dev libpng-dev libwebp-dev openjpeg-dev freetype-dev

COPY --from=source /src/gitfive /src/gitfive

RUN pip install --no-cache-dir --prefix=/install /src/gitfive

# ── Stage 3: runtime ───────────────────────────────────────────────────────────
# Pillow necesita las librerías de imagen en runtime (no solo en build time).
FROM python:3.11-alpine

RUN apk add --no-cache \
        ca-certificates \
        libjpeg-turbo \
        libpng \
        libwebp \
        openjpeg \
        freetype

COPY --from=builder /install /usr/local

# El directorio de configuración (~/.gitfive/) se monta como named volume.
# Primera vez: podman exec -it gitfive gitfive init
VOLUME ["/root/.gitfive"]

ENV PYTHONUNBUFFERED=1

CMD ["sleep", "infinity"]
