# ── Stage 1: source ────────────────────────────────────────────────────────────
FROM alpine:3 AS source

RUN apk add --no-cache git ca-certificates
RUN git clone --depth 1 https://github.com/sherlock-project/sherlock /src/sherlock

# ── Stage 2: builder ───────────────────────────────────────────────────────────
# pandas tiene extensiones C; usa wheel musllinux disponible en PyPI.
# gcc es necesario solo por si alguna dep no tiene wheel musl precompilado.
FROM python:3.11-alpine AS builder

RUN apk add --no-cache gcc musl-dev g++

COPY --from=source /src/sherlock /src/sherlock

# pip resuelve el build backend Poetry de forma automática.
# El flag --prefix permite copiar el resultado al runtime sin build tools.
RUN pip install --no-cache-dir --prefix=/install /src/sherlock

# ── Stage 3: runtime ───────────────────────────────────────────────────────────
FROM python:3.11-alpine

RUN apk add --no-cache ca-certificates

COPY --from=builder /install /usr/local

ENV PYTHONUNBUFFERED=1

CMD ["sleep", "infinity"]
