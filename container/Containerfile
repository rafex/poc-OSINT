# ── Stage 1: source ────────────────────────────────────────────────────────────
# Clona PHOMBER. Git NO llega a la imagen final.
FROM alpine:3 AS source

RUN apk add --no-cache git ca-certificates
RUN git clone --depth 1 https://github.com/s41r4j/phomber /src/phomber

# ── Stage 2: builder ───────────────────────────────────────────────────────────
# Instala dependencias Python con herramientas de compilación que NO van al runtime.
# psutil requiere gcc (extensión C); el resto son pure-Python o tienen wheels musl.
FROM python:3.11-alpine AS builder

RUN apk add --no-cache gcc musl-dev linux-headers

COPY --from=source /src/phomber /src/phomber

# Instala deps leyendo pyproject.toml (mismo mecanismo que antes, adaptado a Alpine).
# Nota: Podman imagebuilder sin BuildKit no soporta heredocs en RUN.
RUN python3 -c "\
import tomllib, subprocess, sys; \
f = open('/src/phomber/pyproject.toml', 'rb'); \
deps = tomllib.load(f)['project']['dependencies']; \
f.close(); \
subprocess.check_call([sys.executable, '-m', 'pip', 'install', \
    '--no-cache-dir', '--prefix=/install'] + deps)"

# ── Stage 3: runtime ───────────────────────────────────────────────────────────
FROM python:3.11-alpine

# whois: requerido por python-whois para consultas WHOIS del sistema.
RUN apk add --no-cache ca-certificates whois

# Dependencias Python del builder (sin gcc ni musl-dev en runtime)
COPY --from=builder /install /usr/local

# Código fuente de PHOMBER
COPY --from=source /src/phomber /opt/phomber

WORKDIR /opt/phomber

# Wrapper en PATH para invocación transparente via `podman exec`
RUN printf '#!/bin/sh\nexec python3 /opt/phomber/phomber.py "$@"\n' \
        > /usr/local/bin/phomber \
    && chmod +x /usr/local/bin/phomber

ENV PYTHONUNBUFFERED=1

CMD ["sleep", "infinity"]
