# Containerfile.llama — llama-server para validación local en contenedor
#
# Compilado con Alpine (musl libc) para imagen final mínima.
# GGML_NATIVE=OFF: portabilidad entre CPUs (sin optimizaciones micro-arquitectura).
# GGML_OPENMP=OFF: elimina dependencia de libgomp en runtime.
#
# En producción sobre Raspberry Pi / Mac Mini se compila directamente en el host
# con GGML_NATIVE=ON y GGML_OPENMP=ON para máximo rendimiento.

# ── Stage 1: compilación ───────────────────────────────────────────────────────
FROM alpine:3 AS builder

# alpine-sdk trae gcc, g++, make, binutils.
# cmake y linux-headers son necesarios para llama.cpp.
RUN apk add --no-cache git cmake make g++ musl-dev linux-headers ca-certificates

RUN git clone --depth 1 https://github.com/ggml-org/llama.cpp /opt/llama.cpp

WORKDIR /opt/llama.cpp

RUN cmake -B build \
        -DGGML_NATIVE=OFF \
        -DGGML_OPENMP=OFF \
        -DCMAKE_BUILD_TYPE=Release \
    && cmake --build build \
        --config Release \
        --parallel \
        --target llama-server

# ── Stage 2: runtime mínima ────────────────────────────────────────────────────
# libstdc++: runtime C++ requerido por el binario compilado con g++.
# curl: usado por el HEALTHCHECK.
FROM alpine:3

RUN apk add --no-cache ca-certificates curl libstdc++

COPY --from=builder /opt/llama.cpp/build/bin/llama-server /usr/local/bin/llama-server

RUN adduser -S -H llama
USER llama

VOLUME ["/models"]
EXPOSE 8080

HEALTHCHECK --interval=15s --timeout=5s --start-period=60s --retries=3 \
    CMD curl -sf http://localhost:8080/health || exit 1

ENTRYPOINT ["llama-server"]
