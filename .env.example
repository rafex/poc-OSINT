# edge-osint-lab — variables de entorno
# Copia este archivo como .env y rellena los valores reales.
# El archivo .env nunca debe subirse al repositorio.

# ── Cadena de proveedores LLM ─────────────────────────────────────────────────
# Orden de prioridad separado por pipes.
# Valores válidos: openai-compat, local
LLM_PROVIDER=openai-compat|local

# ── Proveedor remoto (compatible con OpenAI SDK) ──────────────────────────────
# Funciona con cualquier API que implemente el protocolo OpenAI:
#   Groq     → https://api.groq.com/openai/v1
#   DeepSeek → https://api.deepseek.com/v1
#   OpenRouter → https://openrouter.ai/api/v1
#   Ollama (remoto) → http://host:11434/v1
PROVIDER_LLM_BASE_URL=https://api.groq.com/openai/v1
PROVIDER_LLM_API_KEY=REEMPLAZA_CON_TU_KEY
# Modelo a usar en el proveedor remoto
PROVIDER_LLM_MODEL=llama-3.1-8b-instant

# ── llama.cpp local (fallback sin internet) ───────────────────────────────────
LLAMA_SERVER_URL=http://localhost:8080
# Nombre descriptivo del modelo cargado localmente (solo para logs)
LOCAL_MODEL_NAME=qwen2-0.5b-instruct-q4_k_m

# ── Compose / modelo ──────────────────────────────────────────────────────────
# Directorio donde residen los archivos GGUF (montado como volumen en compose)
MODEL_DIR=$HOME/models
# Nombre del archivo de modelo dentro de MODEL_DIR
MODEL_FILE=qwen2-0_5b-instruct-q4_k_m.gguf
# Puerto expuesto por llama-server (perfil local-llm)
LLAMA_PORT=8080
# Parámetros de inferencia para llama-server en contenedor
LLAMA_CTX=2048
LLAMA_THREADS=4

# ── Contenedor Podman ─────────────────────────────────────────────────────────
CONTAINER_NAME=phomber

# ── Logging ───────────────────────────────────────────────────────────────────
# DEBUG muestra la cadena de proveedores completa y el camino de fallback.
# WARNING muestra solo errores y advertencias.
LOG_LEVEL=WARNING
