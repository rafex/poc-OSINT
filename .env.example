# edge-osint-lab — variables de entorno
# Copia este archivo como .env y rellena los valores reales.
# El archivo .env nunca debe subirse al repositorio.

# ── Cadena de proveedores LLM ─────────────────────────────────────────────────
# Orden de prioridad separado por pipes. Solo se intentan los que tengan key.
# Valores válidos: groq, deepseek, local
LLM_PROVIDER=groq|deepseek|local

# ── Groq ──────────────────────────────────────────────────────────────────────
# Obtén tu key en: https://console.groq.com/keys
GROQ_API_KEY=gsk_REEMPLAZA_CON_TU_KEY
# Modelos disponibles: llama-3.1-8b-instant, llama-3.3-70b-versatile, gemma2-9b-it
GROQ_MODEL=llama-3.1-8b-instant

# ── DeepSeek ──────────────────────────────────────────────────────────────────
# Obtén tu key en: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-REEMPLAZA_CON_TU_KEY
# deepseek-chat = V3 (rápido, económico)  |  deepseek-reasoner = R1 (más lento, más capaz)
DEEPSEEK_MODEL=deepseek-chat

# ── llama.cpp local (fallback) ────────────────────────────────────────────────
LLAMA_SERVER_URL=http://localhost:8080
# Nombre descriptivo del modelo cargado localmente (solo para logs)
LOCAL_MODEL_NAME=qwen2-0.5b-instruct-q4_k_m

# ── Compose / modelo ──────────────────────────────────────────────────────────
# Directorio donde residen los archivos GGUF (montado como volumen en compose)
MODEL_DIR=$HOME/models
# Nombre del archivo de modelo dentro de MODEL_DIR
MODEL_FILE=qwen2-0_5b-instruct-q4_k_m.gguf
# Puerto expuesto por llama-server (perfil local-llm)
LLAMA_PORT=8080
# Parámetros de inferencia para llama-server en contenedor
LLAMA_CTX=2048
LLAMA_THREADS=4

# ── Contenedor Podman ─────────────────────────────────────────────────────────
CONTAINER_NAME=phomber

# ── Logging ───────────────────────────────────────────────────────────────────
# DEBUG muestra la cadena de proveedores completa y el camino de fallback.
# WARNING muestra solo errores y advertencias.
LOG_LEVEL=WARNING
